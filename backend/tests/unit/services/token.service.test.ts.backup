/**
 * Token Service Unit Tests
 * Tests JWT token generation, verification, and security features
 */

import { beforeEach, describe, expect, it, jest } from '@jest/globals';
import { JwtTokenService } from '../../../src/infrastructure/services/token.service.js';
import { TokenClaims, TokenType } from '../../../src/core/entities/auth.entity.js';
import { User, UserRole } from '../../../src/core/entities/user.entity.js';

// Mock the jsonwebtoken module using a different approach
jest.mock('jsonwebtoken', () => ({
  __esModule: true,
  default: {
    sign: jest.fn(),
    verify: jest.fn(),
    decode: jest.fn(),
  },
  sign: jest.fn(),
  verify: jest.fn(),
  decode: jest.fn(),
}));

// Import the mocked functions
import jwt from 'jsonwebtoken';
const mockJwt = jwt as jest.Mocked<typeof jwt>;

describe('TokenService', () => {
  let tokenService: JwtTokenService;
  let mockConfig: any;  beforeEach(() => {
    mockConfig = {
      accessTokenSecret: 'test-access-secret',
      refreshTokenSecret: 'test-refresh-secret',
      emailTokenSecret: 'test-email-secret',
      passwordResetTokenSecret: 'test-reset-secret',
      accessTokenExpiry: '15m',
      refreshTokenExpiry: '7d',
      emailTokenExpiry: '24h',
      passwordResetTokenExpiry: '1h',
    };

    tokenService = new JwtTokenService(mockConfig);

    // Reset all mocks
    jest.clearAllMocks();
  });
  describe('generateToken', () => {
    it('should generate valid JWT tokens', async () => {
      // Arrange
      const tokenClaims: Omit<TokenClaims, 'iat' | 'exp'> = {
        sub: 'user123',
        email: 'test@example.com',
        username: 'testuser',
        role: UserRole.USER,
        jti: 'session123',
        tokenType: TokenType.ACCESS,
      };

      // Act
      const result = await tokenService.generateToken(tokenClaims);

      // Assert
      expect(result).toBeDefined();
      expect(typeof result).toBe('string');
      expect(result.split('.')).toHaveLength(3); // JWT format: header.payload.signature
    });

    it('should include session ID in jti claim', async () => {
      // Arrange
      const sessionId = 'unique-session-123';
      const tokenClaims: Omit<TokenClaims, 'iat' | 'exp'> = {
        sub: 'user123',
        email: 'test@example.com',
        username: 'testuser',
        role: UserRole.USER,
        jti: sessionId,
        tokenType: TokenType.ACCESS,
      };

      mockJwt.sign.mockReturnValue('token');

      // Act
      await tokenService.generateToken(tokenClaims);

      // Assert
      expect(mockJwt.sign).toHaveBeenCalledWith(
        expect.objectContaining({
          jti: sessionId,
        }),
        expect.any(String),
        expect.any(Object)
      );
    });

    it('should use correct secret for different token types', async () => {
      // Arrange
      const accessTokenClaims: Omit<TokenClaims, 'iat' | 'exp'> = {
        sub: 'user123',
        email: 'test@example.com',
        username: 'testuser',
        role: UserRole.USER,
        jti: 'session123',
        tokenType: TokenType.ACCESS,
      };

      const refreshTokenClaims: Omit<TokenClaims, 'iat' | 'exp'> = {
        sub: 'user123',
        email: 'test@example.com',
        username: 'testuser',
        role: UserRole.USER,
        jti: 'session123',
        tokenType: TokenType.REFRESH,
      };

      mockJwt.sign.mockReturnValue('token');

      // Act
      await tokenService.generateToken(accessTokenClaims);
      await tokenService.generateToken(refreshTokenClaims);

      // Assert
      expect(mockJwt.sign).toHaveBeenNthCalledWith(
        1,
        expect.any(Object),
        'test-access-secret',
        expect.any(Object)
      );
      expect(mockJwt.sign).toHaveBeenNthCalledWith(
        2,
        expect.any(Object),
        'test-refresh-secret',
        expect.any(Object)
      );
    });

    it('should generate secure refresh tokens', async () => {
      // Arrange
      const refreshTokenClaims: Omit<TokenClaims, 'iat' | 'exp'> = {
        sub: 'user123',
        email: 'test@example.com',
        username: 'testuser',
        role: UserRole.USER,
        jti: 'session123',
        tokenType: TokenType.REFRESH,
      };

      const expectedToken = 'refresh.jwt.token';
      mockJwt.sign.mockReturnValue(expectedToken);

      // Act
      const result = await tokenService.generateToken(refreshTokenClaims);

      // Assert
      expect(result).toBe(expectedToken);
      expect(mockJwt.sign).toHaveBeenCalledWith(
        expect.objectContaining({
          tokenType: TokenType.REFRESH,
        }),
        'test-refresh-secret',
        expect.any(Object)
      );
    });
  });

  describe('verifyToken', () => {
    it('should verify tokens correctly', async () => {
      // Arrange
      const token = 'valid.jwt.token';
      const expectedClaims: TokenClaims = {
        sub: 'user123',
        email: 'test@example.com',
        username: 'testuser',
        role: UserRole.USER,
        jti: 'session123',
        tokenType: TokenType.ACCESS,
        iat: Math.floor(Date.now() / 1000),
        exp: Math.floor(Date.now() / 1000) + 3600,
      };

      // Mock decode to return token type
      mockJwt.decode.mockReturnValue(expectedClaims);
      // Mock verify to return full claims
      mockJwt.verify.mockReturnValue(expectedClaims);

      // Act
      const result = await tokenService.verifyToken(token);

      // Assert
      expect(result).toEqual(expectedClaims);
      expect(mockJwt.decode).toHaveBeenCalledWith(token);
      expect(mockJwt.verify).toHaveBeenCalledWith(
        token,
        'test-access-secret',
        expect.objectContaining({
          issuer: 'universe-book-writer',
          audience: 'universe-book-writer-app',
        })
      );
    });

    it('should handle token expiration', async () => {
      // Arrange
      const expiredToken = 'expired.jwt.token';
      const tokenClaims = {
        tokenType: TokenType.ACCESS,
      };

      mockJwt.decode.mockReturnValue(tokenClaims);
      mockJwt.verify.mockImplementation(() => {
        const error = new Error('Token expired');
        error.name = 'TokenExpiredError';
        throw error;
      });

      // Act & Assert
      await expect(tokenService.verifyToken(expiredToken)).rejects.toThrow(
        'Token has expired'
      );
    });

    it('should handle invalid tokens', async () => {
      // Arrange
      const invalidToken = 'invalid.jwt.token';
      const tokenClaims = {
        tokenType: TokenType.ACCESS,
      };

      mockJwt.decode.mockReturnValue(tokenClaims);
      mockJwt.verify.mockImplementation(() => {
        const error = new Error('Invalid token');
        error.name = 'JsonWebTokenError';
        throw error;
      });

      // Act & Assert
      await expect(tokenService.verifyToken(invalidToken)).rejects.toThrow(
        'Invalid token'
      );
    });

    it('should handle malformed token format', async () => {
      // Arrange
      const malformedToken = 'malformed.token';

      mockJwt.decode.mockReturnValue(null);

      // Act & Assert
      await expect(tokenService.verifyToken(malformedToken)).rejects.toThrow(
        'Invalid token format'
      );
    });

    it('should use correct secret based on token type', async () => {
      // Arrange
      const refreshToken = 'refresh.jwt.token';
      const refreshTokenClaims: TokenClaims = {
        sub: 'user123',
        email: 'test@example.com',
        username: 'testuser',
        role: UserRole.USER,
        jti: 'session123',
        tokenType: TokenType.REFRESH,
        iat: Math.floor(Date.now() / 1000),
        exp: Math.floor(Date.now() / 1000) + 3600,
      };

      mockJwt.decode.mockReturnValue(refreshTokenClaims);
      mockJwt.verify.mockReturnValue(refreshTokenClaims);

      // Act
      await tokenService.verifyToken(refreshToken);

      // Assert
      expect(mockJwt.verify).toHaveBeenCalledWith(
        refreshToken,
        'test-refresh-secret',
        expect.any(Object)
      );
    });
  });

  describe('generateTokenPair', () => {
    it('should generate both access and refresh tokens', async () => {
      // Arrange
      const mockUser = {
        id: 'user123',
        email: 'test@example.com',
        username: 'testuser',
        role: UserRole.USER,
      } as User;

      const deviceInfo = {
        userAgent: 'Mozilla/5.0',
        ip: '192.168.1.1',
      };

      mockJwt.sign
        .mockReturnValueOnce('access.token')
        .mockReturnValueOnce('refresh.token');

      // Act
      const result = await tokenService.generateTokenPair(mockUser, deviceInfo);

      // Assert
      expect(result).toEqual({
        accessToken: 'access.token',
        refreshToken: 'refresh.token',
        accessTokenExpiresAt: expect.any(Date),
        refreshTokenExpiresAt: expect.any(Date),
      });
      expect(mockJwt.sign).toHaveBeenCalledTimes(2);
    });
  });

  describe('generateVerificationToken', () => {
    it('should generate email verification tokens', async () => {
      // Arrange
      const mockUser = {
        id: 'user123',
        email: 'test@example.com',
      } as User;

      mockJwt.sign.mockReturnValue('verification.token');

      // Act
      const result = await tokenService.generateVerificationToken(
        mockUser,
        TokenType.EMAIL_VERIFICATION
      );

      // Assert
      expect(result).toEqual({
        token: 'verification.token',
        expiresAt: expect.any(Date),
      });
      expect(mockJwt.sign).toHaveBeenCalledWith(
        expect.objectContaining({
          sub: 'user123',
          email: 'test@example.com',
          tokenType: TokenType.EMAIL_VERIFICATION,
        }),
        'test-email-secret',
        expect.any(Object)
      );
    });

    it('should generate password reset tokens', async () => {
      // Arrange
      const mockUser = {
        id: 'user123',
        email: 'test@example.com',
      } as User;

      mockJwt.sign.mockReturnValue('reset.token');

      // Act
      const result = await tokenService.generateVerificationToken(
        mockUser,
        TokenType.PASSWORD_RESET
      );

      // Assert
      expect(result).toEqual({
        token: 'reset.token',
        expiresAt: expect.any(Date),
      });
      expect(mockJwt.sign).toHaveBeenCalledWith(
        expect.objectContaining({
          tokenType: TokenType.PASSWORD_RESET,
        }),
        'test-reset-secret',
        expect.any(Object)
      );
    });
  });

  describe('verifyVerificationToken', () => {
    it('should verify email verification tokens', async () => {
      // Arrange
      const token = 'verification.token';
      const tokenClaims: TokenClaims = {
        sub: 'user123',
        email: 'test@example.com',
        username: 'testuser',
        role: UserRole.USER,
        jti: 'verification123',
        tokenType: TokenType.EMAIL_VERIFICATION,
        iat: Math.floor(Date.now() / 1000),
        exp: Math.floor(Date.now() / 1000) + 3600,
      };

      mockJwt.decode.mockReturnValue(tokenClaims);
      mockJwt.verify.mockReturnValue(tokenClaims);

      // Act
      const result = await tokenService.verifyVerificationToken(
        token,
        TokenType.EMAIL_VERIFICATION
      );

      // Assert
      expect(result).toEqual({
        userId: 'user123',
        isValid: true,
        claims: tokenClaims,
      });
    });

    it('should reject wrong token types', async () => {
      // Arrange
      const token = 'verification.token';
      const tokenClaims: TokenClaims = {
        sub: 'user123',
        email: 'test@example.com',
        username: 'testuser',
        role: UserRole.USER,
        jti: 'verification123',
        tokenType: TokenType.ACCESS, // Wrong type
        iat: Math.floor(Date.now() / 1000),
        exp: Math.floor(Date.now() / 1000) + 3600,
      };

      mockJwt.decode.mockReturnValue(tokenClaims);
      mockJwt.verify.mockReturnValue(tokenClaims);

      // Act
      const result = await tokenService.verifyVerificationToken(
        token,
        TokenType.EMAIL_VERIFICATION
      );

      // Assert
      expect(result).toEqual({
        userId: 'user123',
        isValid: false,
      });
    });

    it('should handle verification token errors gracefully', async () => {
      // Arrange
      const invalidToken = 'invalid.token';

      mockJwt.decode.mockImplementation(() => {
        throw new Error('Malformed token');
      });

      // Act
      const result = await tokenService.verifyVerificationToken(
        invalidToken,
        TokenType.EMAIL_VERIFICATION
      );

      // Assert
      expect(result).toEqual({
        userId: 'unknown',
        isValid: false,
      });
    });
  });

  describe('getTokenExpiration', () => {
    it('should return correct expiration times for different token types', () => {
      // Act & Assert
      expect(tokenService.getTokenExpiration(TokenType.ACCESS)).toBe(15 * 60 * 1000); // 15 minutes
      expect(tokenService.getTokenExpiration(TokenType.REFRESH)).toBe(7 * 24 * 60 * 60 * 1000); // 7 days
      expect(tokenService.getTokenExpiration(TokenType.EMAIL_VERIFICATION)).toBe(24 * 60 * 60 * 1000); // 24 hours
      expect(tokenService.getTokenExpiration(TokenType.PASSWORD_RESET)).toBe(60 * 60 * 1000); // 1 hour
    });
  });

  describe('Security Features', () => {
    it('should include proper issuer and audience claims', async () => {
      // Arrange
      const tokenClaims: Omit<TokenClaims, 'iat' | 'exp'> = {
        sub: 'user123',
        email: 'test@example.com',
        username: 'testuser',
        role: UserRole.USER,
        jti: 'session123',
        tokenType: TokenType.ACCESS,
      };

      mockJwt.sign.mockReturnValue('token');

      // Act
      await tokenService.generateToken(tokenClaims);

      // Assert
      expect(mockJwt.sign).toHaveBeenCalledWith(
        expect.objectContaining({
          iss: 'universe-book-writer',
          aud: 'universe-book-writer-app',
        }),
        expect.any(String),
        expect.any(Object)
      );
    });

    it('should use HS256 algorithm', async () => {
      // Arrange
      const tokenClaims: Omit<TokenClaims, 'iat' | 'exp'> = {
        sub: 'user123',
        email: 'test@example.com',
        username: 'testuser',
        role: UserRole.USER,
        jti: 'session123',
        tokenType: TokenType.ACCESS,
      };

      mockJwt.sign.mockReturnValue('token');

      // Act
      await tokenService.generateToken(tokenClaims);

      // Assert
      expect(mockJwt.sign).toHaveBeenCalledWith(
        expect.any(Object),
        expect.any(String),
        expect.objectContaining({
          algorithm: 'HS256',
        })
      );
    });

    it('should set appropriate expiration times', async () => {
      // Arrange
      const tokenClaims: Omit<TokenClaims, 'iat' | 'exp'> = {
        sub: 'user123',
        email: 'test@example.com',
        username: 'testuser',
        role: UserRole.USER,
        jti: 'session123',
        tokenType: TokenType.ACCESS,
      };

      mockJwt.sign.mockReturnValue('token');
      const startTime = Math.floor(Date.now() / 1000);

      // Act
      await tokenService.generateToken(tokenClaims);

      // Assert
      expect(mockJwt.sign).toHaveBeenCalledWith(
        expect.objectContaining({
          iat: expect.any(Number),
          exp: expect.any(Number),
        }),
        expect.any(String),
        expect.any(Object)
      );

      const call = mockJwt.sign.mock.calls[0];
      const payload = call[0] as any;
      expect(payload.iat).toBeGreaterThanOrEqual(startTime);
      expect(payload.exp).toBeGreaterThan(payload.iat);
    });
  });
});
