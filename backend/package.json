{
  "name": "@verseforge/backend",
  "version": "0.0.1-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npx tsx ../scripts/run-tests-with-output.ts backend",
    "test:watch": "npx tsx ../scripts/run-tests-with-output.ts backend --watch",
    "test:coverage": "npx tsx ../scripts/run-tests-with-output.ts backend --coverage",
    "test:pattern": "npx tsx ../scripts/run-tests-with-output.ts backend --pattern",
    "test:verbose": "npx tsx ../scripts/run-tests-with-output.ts backend --verbose",
    "test:direct": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.mjs",
    "lint": "eslint src --ext .ts",
    "setup-env": "node scripts/setup-env.mjs",
    "postinstall": "npm run setup-env",
    "migrate": "npx tsx scripts/migrate-runner.ts up",
    "migrate:status": "npx tsx scripts/migrate-runner.ts status",
    "migrate:up": "npx tsx scripts/migrate-runner.ts up",
    "migrate:down": "npx tsx scripts/migrate-runner.ts down",
    "bypass-verification": "npx tsx scripts/bypass-verification.ts",
    "cleanup-databases": "npx tsx scripts/cleanup-databases.ts",
    "seed:road-to-stars": "node --import ./register.js src/scripts/seed-road-to-stars.ts",
    "verify:road-to-stars": "node --import ./register.js src/scripts/verify-road-to-stars-seed.ts"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-slow-down": "^2.1.0",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "nodemailer": "^6.9.7",
    "xss-clean": "^0.1.4",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^5.0.2",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-slow-down": "^1.3.5",
    "@types/hpp": "^0.2.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "migrate-mongo": "^12.1.3",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3"
  }
}