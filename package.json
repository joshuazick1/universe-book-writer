{
  "name": "universe-book-writer",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "frontend",
      "backend",
      "ai-server",
      "plugins/*",
      "tools/*"
    ],
    "nohoist": [
      "**/vite",
      "**/tailwindcss",
      "**/express",
      "**/react",
      "**/react-dom"
    ]
  },
  "scripts": {
    "prepare": "husky install",
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "clean": "rimraf \"packages/*/dist\" \"frontend/dist\" \"backend/dist\" \"ai-server/dist\"",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:ai\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:ai": "npm run dev -w ai-server",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check-updates": "npm-check-updates",
    "check-updates:interactive": "npm-check-updates -i",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "precommit": "lint-staged && npm run typecheck && npm test"
  },
  "dependencies": {
    "tslib": "^2.6.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@shelf/jest-mongodb": "^1.1.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/redis-mock": "^0.17.3",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^8.0.3",
    "ioredis": "^5.6.1",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "jest-redis": "^0.1.0",
    "lint-staged": "^15.2.0",
    "mongodb": "^4.17.2",
    "mongodb-memory-server": "^8.15.1",
    "npm-check-updates": "^18.0.1",
    "prettier": "^3.1.1",
    "redis": "^5.5.6",
    "redis-mock": "^0.56.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.3.3"
  }
}
