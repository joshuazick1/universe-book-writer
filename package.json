{
  "name": "verseforge",
  "version": "0.0.1-alpha.1",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "frontend",
      "backend",
      "ai-server",
      "collaboration-server",
      "plugins/*",
      "tools/*"
    ],
    "nohoist": [
      "**/vite",
      "**/tailwindcss",
      "**/express",
      "**/react",
      "**/react-dom"
    ]
  },
  "scripts": {
    "prepare": "husky install",
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "clean": "node -e \"['packages/*/dist','frontend/dist','backend/dist','ai-server/dist'].forEach(p=>{try{require('fs').rmSync(p,{recursive:true,force:true})}catch{}})\"",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:ai\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:ai": "npm run dev -w ai-server",
    "test": "npx tsx scripts/run-tests-with-output.ts",
    "test:console": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:backend": "npx tsx scripts/run-tests-with-output.ts backend",
    "test:frontend": "npx tsx scripts/run-tests-with-output.ts frontend",
    "test:ai-server": "npx tsx scripts/run-tests-with-output.ts ai-server",
    "test:collaboration-server": "npx tsx scripts/run-tests-with-output.ts collaboration-server",
    "test:packages": "npx tsx scripts/run-tests-with-output.ts packages",
    "test:e2e-jest": "npx tsx scripts/run-tests-with-output.ts e2e",
    "test:watch": "npx tsx scripts/run-tests-with-output.ts --watch",
    "test:coverage": "npx tsx scripts/run-tests-with-output.ts --coverage",
    "test:coverage:backend": "npx tsx scripts/run-tests-with-output.ts backend --coverage",
    "test:coverage:frontend": "npx tsx scripts/run-tests-with-output.ts frontend --coverage",
    "test:pattern": "npx tsx scripts/run-tests-with-output.ts --pattern",
    "test:file": "npx tsx scripts/run-tests-with-output.ts --file",
    "test:verbose": "npx tsx scripts/run-tests-with-output.ts --verbose",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:html": "playwright test --reporter=html",
    "test:e2e:report": "playwright show-report",
    "test:e2e:admin": "playwright test --config=e2e/playwright.admin.config.ts",
    "test:e2e:admin:ui": "playwright test --config=e2e/playwright.admin.config.ts --ui",
    "test:e2e:admin:headed": "playwright test --config=e2e/playwright.admin.config.ts --headed",
    "test:e2e:admin:debug": "playwright test --config=e2e/playwright.admin.config.ts --debug",
    "test:e2e:admin:html": "playwright test --config=e2e/playwright.admin.config.ts --reporter=html",
    "test:e2e:admin:report": "playwright show-report test-results/admin-components-html",
    "check-updates": "npm-check-updates",
    "check-updates:interactive": "npm-check-updates -i",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "precommit": "lint-staged && npm run typecheck && npm test"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.1.1",
    "@types/cors": "^2.8.19",
    "@types/uuid": "^10.0.0",
    "axios": "^1.9.0",
    "axios-cookiejar-support": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.56.2",
    "concurrently": "^9.1.2",
    "cookie-parser": "^1.4.6",
    "core-js": "^3.35.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-slow-down": "^2.1.0",
    "express-validator": "^7.0.1",
    "glob": "^11.0.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "natural": "^8.1.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.7",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hook-form": "^7.57.0",
    "react-router-dom": "^6.30.1",
    "socket.io": "^4.7.5",
    "strip-ansi-cli": "^4.0.0",
    "tough-cookie": "^5.1.2",
    "tslib": "^2.6.0",
    "uuid": "^10.0.0",
    "xss-clean": "^0.1.4",
    "zod": "^3.25.56",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@biomejs/biome": "^1.9.4",
    "@chromatic-com/storybook": "^4.0.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.52.0",
    "@storybook/addon-a11y": "^9.0.6",
    "@storybook/addon-docs": "^9.0.6",
    "@storybook/addon-onboarding": "^9.0.6",
    "@storybook/addon-vitest": "^9.0.6",
    "@storybook/react-vite": "^9.0.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-slow-down": "^1.3.5",
    "@types/hpp": "^0.2.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.12",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/testing-library__user-event": "^4.1.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/browser": "^3.2.2",
    "@vitest/coverage-v8": "^3.2.2",
    "autoprefixer": "^10.4.16",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-storybook": "^9.0.6",
    "husky": "^8.0.3",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "lint-staged": "^15.2.0",
    "migrate-mongo": "^12.1.3",
    "mongodb-memory-server": "^10.1.4",
    "npm-check-updates": "^18.0.1",
    "playwright": "^1.52.0",
    "postcss": "^8.4.31",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "storybook": "^9.0.6",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.3",
    "typescript": "~5.3.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.2",
    "whatwg-fetch": "^3.6.20"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  }
}
