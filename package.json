{
  "name": "universe-book-writer",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "frontend",
      "backend",
      "ai-server",
      "collaboration-server",
      "plugins/*",
      "tools/*"
    ],
    "nohoist": [
      "**/vite",
      "**/tailwindcss",
      "**/express",
      "**/react",
      "**/react-dom"
    ]
  },
  "scripts": {
    "prepare": "husky install",
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "clean": "node -e \"['packages/*/dist','frontend/dist','backend/dist','ai-server/dist'].forEach(p=>{try{require('fs').rmSync(p,{recursive:true,force:true})}catch{}})\"",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:ai\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:ai": "npm run dev -w ai-server",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:backend": "cross-env TEST_ENV=node node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js \"backend|packages/core\" --detectOpenHandles --forceExit",
    "test:frontend": "cross-env TEST_ENV=jsdom node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js \"frontend|packages/ui-core\" --detectOpenHandles --forceExit",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --coverage --detectOpenHandles --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check-updates": "npm-check-updates",
    "check-updates:interactive": "npm-check-updates -i",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "precommit": "lint-staged && npm run typecheck && npm test"
  },
  "dependencies": {
    "core-js": "^3.35.0",
    "tslib": "^2.6.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "husky": "^8.0.3",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.0",
    "mongodb": "^6.3.0",
    "mongodb-memory-server": "^10.1.4",
    "npm-check-updates": "^18.0.1",
    "prettier": "^3.1.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.3.3"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  }
}
