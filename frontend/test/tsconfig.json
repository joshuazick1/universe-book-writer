{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "jest",
      "node",
      "@testing-library/jest-dom",
      "@testing-library/user-event"
    ],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react",
    "noEmit": true,
    "paths": {
      "@/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "../src/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.d.ts",
    "./jest-setup.ts"
  ]
}