{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "composite": true,
    "declarationMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "types": ["node"]
  },
  "references": [
    { "path": "../packages/core" },
    { "path": "../packages/ui-core" },
    { "path": "../packages/plugin-sdk" }
  ],
  "include": ["src/**/*"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx"
  ]
}
