{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "composite": true,
    "declarationMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": true,
    "types": [
      "node"
    ],
    "moduleResolution": "node",
    "emitDeclarationOnly": false,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../packages/*"
      ],
      "@src/*": [
        "src/*"
      ]
    }
  },
  "references": [
    {
      "path": "../packages/core"
    },
    {
      "path": "../packages/ui-core"
    },
    {
      "path": "../packages/plugin-sdk"
    }
  ],
  "include": [
    "src/**/*",
    "test/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx"
  ]
}