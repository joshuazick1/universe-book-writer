{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./packages/*"]
    },
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "types": ["jest", "node"],
    "typeRoots": ["./node_modules/@types", "./"],
    "checkJs": false
  },
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/ui-core" },
    { "path": "./packages/plugin-sdk" },
    { "path": "./frontend" },
    { "path": "./backend" },
    { "path": "./ai-server" },
    { "path": "./collaboration-server" }
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/*.test.ts",
    "**/*.config.js",
    "**/*.config.ts",
    "**/*.config.mjs",
    "jest*.js",
    "jest*.ts",
    "jest*.mjs",
    "commitlint.config.js",
    "**/scripts/**/*.js",
    "**/scripts/**/*.mjs",
    "**/migrate-mongo-config.js",
    "backend/plugins/test-core.plugin.js",
    "backend/tests/jest.env.mjs",
    "backend/register.js",
    "*.d.ts"
  ]
}
