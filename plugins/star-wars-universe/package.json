{
    "name": "star-wars-universe-plugin",
    "version": "0.0.1-dev",
    "description": "Official Star Wars Universe plugin with Imperial/Rebel themes and galactic politics",
    "main": "index.ts",
    "type": "module",
    "author": "VerseForge Team",
    "license": "MIT",
    "keywords": [
        "star-wars",
        "sci-fi",
        "universe",
        "imperial",
        "rebel",
        "force"
    ],
