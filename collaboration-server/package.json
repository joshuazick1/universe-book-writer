{
  "name": "@verseforge/collaboration-server",
  "version": "0.0.1-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npx tsx ../scripts/run-tests-with-output.ts collaboration-server",
    "test:watch": "npx tsx ../scripts/run-tests-with-output.ts collaboration-server --watch",
    "test:coverage": "npx tsx ../scripts/run-tests-with-output.ts collaboration-server --coverage",
    "test:pattern": "npx tsx ../scripts/run-tests-with-output.ts collaboration-server --pattern",
    "test:verbose": "npx tsx ../scripts/run-tests-with-output.ts collaboration-server --verbose",
    "test:direct": "jest",
    "test:direct:watch": "jest --watch",
    "test:direct:coverage": "jest --coverage",
    "test:direct:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}