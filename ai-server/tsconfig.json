{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "declarationMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "isolatedModules": true
  },
  "references": [
    {
      "path": "../packages/core"
    }
  ],
  "files": [
    "src/config/database.config.ts"
  ],
  "include": [
    "src/**/*",
    "orchestrator/**/*.ts",
    "benchmarking/**/*.ts",
    "types/**/*.ts",
    "tests/**/*",
    "tests/unit/**/*.ts",
    "tests/unit/**/*.test.ts",
    "tests/unit/**/*.js",
    "../shared/**/*.ts",
    "../packages/plugin-sdk/src/**/*.ts"
  ]
}