{
  "name": "@universe-book-writer/ai-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npx tsx ../scripts/run-tests-with-output.ts ai-server",
    "test:watch": "npx tsx ../scripts/run-tests-with-output.ts ai-server --watch",
    "test:coverage": "npx tsx ../scripts/run-tests-with-output.ts ai-server --coverage",
    "test:pattern": "npx tsx ../scripts/run-tests-with-output.ts ai-server --pattern",
    "test:verbose": "npx tsx ../scripts/run-tests-with-output.ts ai-server --verbose",
    "test:direct": "jest",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "ts-jest": "^29.3.4",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  }
}
