{
  "name": "@verseforge/ai-server",
  "version": "0.0.1-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npx tsx ../scripts/run-tests-with-output.ts ai-server",
    "test:watch": "npx tsx ../scripts/run-tests-with-output.ts ai-server --watch",
    "test:coverage": "npx tsx ../scripts/run-tests-with-output.ts ai-server --coverage",
    "test:pattern": "npx tsx ../scripts/run-tests-with-output.ts ai-server --pattern",
    "test:verbose": "npx tsx ../scripts/run-tests-with-output.ts ai-server --verbose",
    "test:direct": "jest",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "tsx": "^4.20.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/socket.io": "^3.0.1",
    "axios": "^1.9.0",
    "bleu-score": "^1.0.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mongodb": "^6.17.0",
    "multer": "^2.0.1",
    "natural": "^8.1.0",
    "rogue": "^0.2.4",
    "rouge": "^1.0.3",
    "socket.io": "^4.8.1",
    "vite": "^6.3.5"
  }
}
